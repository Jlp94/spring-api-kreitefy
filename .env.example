# =====================================================================
#  Kreitefy — Variables de entorno para Docker Compose
#  ⚠️  Este fichero NO debe subirse a GitHub (.gitignore lo excluye)
#  Copia este fichero como .env y rellena los valores reales.
# =====================================================================

# ── Base de datos ─────────────────────────────────────────────────────
DB_NAME=kreitefy
DB_USER=kreitefy
DB_PASSWORD=cambia_esta_contraseña

# ── JWT ───────────────────────────────────────────────────────────────
# Genera uno seguro con: openssl rand -hex 32
JWT_SECRET=cambia_este_secreto_jwt_por_uno_seguro_de_256_bits

# ── OAuth2 Google (opcional) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth2 GitHub (opcional) ──────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
